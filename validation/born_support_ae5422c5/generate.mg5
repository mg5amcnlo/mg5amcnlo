set automatic_html_opening False --no_save
set low_mem_multicore_nlo_generation True --no_save
set nb_core 3 --no_save
set fastjet /export/tmp/rikkert/FastJet/bin/fastjet-config --no_save
import model loop_sm-no_b_mass
define p = g u c d s b u~ c~ d~ s~ b~
define j = p
generate p p > e+ e- [QCD]
output /tmp/mg5_born_support_physics/dy -f -nojpeg
generate p p > t t~ [QCD]
output /tmp/mg5_born_support_physics/ttbar -f -nojpeg
generate p p > w+ j [QCD]
output /tmp/mg5_born_support_physics/wjet -f -nojpeg
quit
