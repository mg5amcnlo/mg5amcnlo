+    def plan_ampli_production(self, jobs, req_acc):
+        """Choose provisional pools and fixed evaluation budgets from the survey.
+
+        A ten percent reserve protects the later channel allocation. Small
+        channels keep a useful pool even when their expected final quota is one.
+        The survey variance sets the rate budget independently of that reserve.
+        """
+        nevents = self.run_card['nevents']
+        absolute = self.cross_sect_dict['xseca']
+        if absolute <= 0. or not any(job['resultABS'] > 0. for job in jobs):
+            raise aMCatNLOError('Cannot generate events: the total absolute '
+                                'cross section is zero.')
+        accuracy = req_acc if req_acc > 0. else 1. / math.sqrt(nevents)
+        rate_scale = abs(self.cross_sect_dict['xsect']) or absolute
+        for job in jobs:
+            fraction = job['resultABS'] / absolute
+            target = max(1000, int(math.ceil(1.1 * nevents * fraction))) if fraction > 0. else 0
+            variance_budget = 0
+            if fraction > 0.:
+                allowed_error = accuracy * rate_scale * math.sqrt(fraction)
+                # AmpliCol writes the total independent sample count in npoints_done.
+                survey_points = max(1, job.get('npoints_done', 1))
+                survey_error = max(job.get('error', 0.), job.get('errorABS', 0.))
+                variance_budget = int(math.ceil(1.1 * survey_points *
+                                      (survey_error / allowed_error) ** 2))
+            job['nevents'] = target
+            job['ampli_budget'] = max(2048, 4 * target, variance_budget) if target else 0
+            job['ampli_requested_accuracy'] = accuracy
+            job['ampli_survey_absolute'] = job['resultABS']
+            job['mint_mode'] = 2
