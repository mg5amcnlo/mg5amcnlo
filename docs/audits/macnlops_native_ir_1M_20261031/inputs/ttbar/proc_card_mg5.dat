#*               Command File for MadGraph5_aMC@NLO         *
#*                                                          *
#*     run as ./bin/mg5_aMC  filename                       *
#*                                                          *
#************************************************************
set group_subprocesses Auto
set ignore_six_quark_processes False
set low_mem_multicore_nlo_generation False
set complex_mass_scheme False
set include_lepton_initiated_processes False
set gauge unitary
set loop_optimized_output True
set loop_color_flows False
set max_npoint_for_channel 0
set default_unset_couplings 99
set max_t_for_channel 99
set zerowidth_tchannel True
set nlo_mixed_expansion True
set automatic_html_opening False --no_save
set auto_update 0 --no_save
set nb_core 40 --no_save
set run_mode 2 --no_save
set ninja /export/slow1/rikkert/mg5amcnlo/HEPTools/lib --no_save
set collier /export/slow1/rikkert/mg5amcnlo/HEPTools/lib --no_save
set lhapdf /nfs/home/rikkert/LHAPDF/bin/lhapdf-config --no_save
set pythia8_path /nfs/home/rikkert/Downloads/pythia8 --no_save
import model loop_sm-no_b_mass
define p = g u c d s u~ c~ d~ s~
define j = g u c d s u~ c~ d~ s~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
define p = 21 2 4 1 3 5 -2 -4 -1 -3 -5 # pass to 5 flavors
define j = p
define p = g u d s c b u~ d~ s~ c~ b~
define j = g u d s c b u~ d~ s~ c~ b~
generate p p > t t~ [QCD]
output /export/slow1/rikkert/macnlops_native_ir_1M_20261031/processes/\
TTbar_5FS -nojpeg
