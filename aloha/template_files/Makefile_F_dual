include ../make_opts

NPWAVE = __npwave__
LIBRARY	= libdhelas$(NPWAVE).$(libext)
LIBDIR  = ../../lib/

BASIC_OBJS = dual_variables.o aloha_functions.o

FFLAGS += $(ALOHA_FLAG)

include ./aloha_file.inc

all: $(LIBDIR)$(LIBRARY)

# Dependencies
aloha_functions.o: dual_variables.o
$(ALOHARoutine): dual_variables.o

$(LIBDIR)$(LIBRARY): $(BASIC_OBJS) $(ALOHARoutine)
	$(call CREATELIB, $@, $^)

clean:
	$(RM) *.o $(LIBDIR)$(LIBRARY)
