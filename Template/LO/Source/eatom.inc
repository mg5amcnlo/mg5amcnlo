C     Bound atomic electron in the initial state (written per subprocess by
C     MG5 for processes with an atom, e.g. e+ eC12 > mu+ mu-). This default
C     version, found through -I../../Source/, means: no bound electron.
      INTEGER IATOM, EATOM_A, EATOM_Z, EATOM_PDG
      PARAMETER (IATOM=0, EATOM_A=0, EATOM_Z=0, EATOM_PDG=0)
