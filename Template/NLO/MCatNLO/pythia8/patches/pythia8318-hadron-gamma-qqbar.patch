+// Backward gamma -> q qbar evolution for a sea quark in a hadron.
+// This channel competes independently with q -> q gamma. The photon is a
+// resolved hadron constituent: xMother = xDaughter/z, not the beam endpoint.
+void SimpleSpaceShower::pT2nextQEDHadronGamma(double pT2begDip,
+  double pT2endDip) {
+
+  BeamParticle& beam = (sideA) ? *beamAPtr : *beamBPtr;
+  int idAbs = abs(idDaughter);
+  if (!beam.isHadron() || idAbs < 1 || idAbs > min(5, nQuarkIn)
+    || beam[iSysNow].isValence()
+    || !flag("SpaceShower:QEDshowerByGamma")) return;
+
+  // Keep heavy conversions above the ordinary heavy-flavour transition.
+  // Incoming legs are massless; the emitted sister retains its shower mass.
+  double m2Heavy = (idAbs == 4) ? m2c : (idAbs == 5) ? m2b : 0.;
+  double pT2cut = max(pT2endDip, 2. * m2Heavy);
+  if (pT2begDip <= pT2cut || m2Dip <= 0.) return;
+  double xMaxAbs = beam.xMax(iSysNow);
+  if (xDaughter <= 0. || xMaxAbs <= xDaughter) return;
+  double xResc = dipEndNow->normalRecoil ? 0.
+    : m2Rec / ((sideA ? x2Now : x1Now) * sCM);
+  double zMin = (xDaughter + xResc) / (xMaxAbs + xResc);
+  double mSister = particleDataPtr->m0(idDaughter);
+  double m2Sister = pow2(mSister);
+  double charge2 = pow2(particleDataPtr->charge(idDaughter));
+  double headroom = parm("SpaceShower:gammaToQuarkHeadroom");
+  double enhance = canEnhanceET ? enhanceFactor("isr:A2QQ") : 1.;
+  double overFac = canEnhanceET ? overFactor : 1.;
+  int MEtype = dipEndNow->MEtype;
+  double meMax = doMEcorrections ? calcMEmax(MEtype, 22, idDaughter) : 1.;
+  double pT2top = pT2begDip;
+
+  // Piecewise constant veto envelope. Refresh PDFs in each scale interval,
+  // and sample the photon/daughter ratio over x as well as Q2. A tunable
+  // headroom and an explicit overweight check avoid silently clipping rates.
+  while (pT2top > pT2cut) {
+    double pT2low = max(pT2cut, EVALPDFSTEP * pT2top);
+    double r = pT2low / m2Dip;
+    double zMax = 2. / (2. + r + sqrt(r * (r + 4.)));
+    if (zMin >= zMax) { pT2top = pT2low; continue; }
+    double ratioMax = 0.;
+    for (int iq = 0; iq < 3; ++iq) {
+      double tPDF = pT2top * pow(pT2low / pT2top, 0.5 * iq);
+      double scale2 = useFixedFacScale ? fixedFacScale2
+        : factorMultFac * tPDF;
+      xfModPrepData xfData = beam.xfModPrep(iSysNow, scale2);
+      double daughter = beam.xfISR(iSysNow, idDaughter, xDaughter,
+        scale2, xfData);
+      if (daughter <= TINYPDF) continue;
+      for (int iz = 0; iz <= 16; ++iz) {
+        double z = zMin * pow(zMax / zMin, iz / 16.);
+        double xMo = (xDaughter + xResc) / z - xResc;
+        double photon = beam.xfISR(iSysNow, 22, xMo, scale2, xfData);
+        ratioMax = max(ratioMax, max(0., photon) / daughter);
+      }
+    }
+    ratioMax *= headroom;
+    if (ratioMax <= 0.) { pT2top = pT2low; continue; }
+    double massMax = 1. + 0.5 * m2Heavy / pT2low;
+    double alphaMax = alphaEM.alphaEM(renormMultFac * pT2top);
+    double rate = alphaMax / (2. * M_PI) * 3. * charge2
+      * (zMax - zMin) * ratioMax * massMax * meMax * enhance * overFac;
+    if (rate <= 0.) return;
+    double pT2 = pT2top;
+
+    while (true) {
+      pT2 *= pow(rndmPtr->flat(), 1. / rate);
+      if (pT2 <= pT2low) break;
+      double z = zMin + (zMax - zMin) * rndmPtr->flat();
+      double xMother = (xDaughter + xResc) / z - xResc;
+      if (xMother >= xMaxAbs) continue;
+      double Q2 = pT2 / (1. - z);
+      double pT2corr = Q2 - z * (m2Dip + Q2) * (Q2 + m2Sister) / m2Dip;
+      if (pT2corr < TINYPT2) continue;
+      double scale2 = useFixedFacScale ? fixedFacScale2
+        : factorMultFac * pT2;
+      xfModPrepData xfData = beam.xfModPrep(iSysNow, scale2);
+      double daughter = beam.xfISR(iSysNow, idDaughter, xDaughter,
+        scale2, xfData);
+      if (daughter <= TINYPDF) continue;
+      double photon = max(0., beam.xfISR(iSysNow, 22, xMother, scale2, xfData));
+      // xf ratios already contain the 1/z Jacobian: no further 1/z here.
+      double kernel = pow2(z) + pow2(1. - z)
+        + 2. * z * (1. - z) * m2Heavy / pT2;
+      double wt = kernel / massMax * photon / (daughter * ratioMax)
+        * alphaEM.alphaEM(renormMultFac * pT2) / alphaMax / overFac;
+      if (doMEcorrections)
+        wt *= calcMEcorr(MEtype, 22, idDaughter, m2Dip, z, Q2,
+          m2Sister) / meMax;
+      if (dopTdamp && iSysNow == 0 && MEtype == 0 && nRad == 0)
+        wt *= pT2damp / (pT2 + pT2damp);
+      if (!isfinite(wt) || wt > 1. + 1e-10)
+        throw std::runtime_error("SimpleSpaceShower gamma -> q qbar: "
+          "PDF veto envelope exceeded; increase SpaceShower:gammaToQuarkHeadroom");
+      wt = min(1., max(0., wt));
+      // Use the existing delayed veto and enhancement weight bookkeeping.
+      bool delayed = canEnhanceET;
+      if (!delayed && wt < rndmPtr->flat()) continue;
+      if (wt <= 0.) continue;
+      dipEndNow->pAccept = delayed ? wt : 1.;
+      splittingNameNow = "isr:A2QQ";
+      if (canEnhanceET) storeEnhanceFactor(pT2, "isr:A2QQ", enhance);
+      dipEndNow->store(idDaughter, 22, -idDaughter, x1Now, x2Now, m2Dip,
+        pT2, z, xMother, Q2, mSister, m2Sister, pT2corr, 0, m2ColPair,
+        mColPartner);
+      return;
+    }
+    pT2top = pT2low;
+  }
 }
 
