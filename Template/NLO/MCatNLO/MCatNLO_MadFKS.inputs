#!/usr/bin/env bash

# SOURCE INPUT FILES
source shower_card.dat
source banner.dat

# PATH TO SOURCE CODES
HWPATH="../srcHerwig"
PYPATH="../srcPythia"

# SHOWER VERSIONS 
HERWIGVER="herwig6521.o"
PYTHIAVER="pythia6428.o"

##### LOAD THE SCRIPTS
# PYTHIA8 is configured by MG5_aMC directly (madgraph/various/mcatnlo_shower.py)
. Scripts/MCatNLO_MadFKS_$MCMODE.Script

##### EXECUTION
# compileMC or runMC
runMC

#### CLEAN UP
rm -f `pwd`/*.o
rm -f `pwd`/*.so
rm -f `pwd`/HW7Analyzer/*.o
rm -f `pwd`/HW7Analyzer/*.so
rm -f `pwd`/Makefile
