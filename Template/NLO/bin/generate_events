""" This is the main script in order to generate events in MadEvent """

import logging
import logging.config
import os
import re
import shutil
import subprocess
import sys
import time
root_path = os.path.split(os.path.dirname(os.path.realpath( __file__ )))[0]
pjoin = os.path.join

def stdin_is_redirected():
    """True when stdin is a pipe, a socket or a file, i.e. neither a terminal
    nor a character device such as /dev/null (batch jobs)."""
    import stat
    try:
        return not stat.S_ISCHR(os.fstat(sys.stdin.fileno()).st_mode)
    except (OSError, ValueError, AttributeError):
        return False

def stdin_has_input():
    """True when something is waiting on stdin. A forced (-f) run never reads
    stdin, so a closed or idle pipe (CI runners, agents) is harmless there,
    but piped answers would be silently dropped."""
    import select
    try:
        if not select.select([sys.stdin], [], [], 0)[0]:
            return False
        return bool(os.read(sys.stdin.fileno(), 1))
    except (OSError, ValueError, AttributeError):
        return False

def is_forced(args):
    """True when the arguments ask for a forced run: -f, alone or among
    combined short options (-fp), or --force."""
    for arg in args:
        if arg == '--force':
            return True
        # "-n myrun" may come as a single argument
        option = (arg.split() or [''])[0]
        if option.startswith('-') and not option.startswith('--') and 'f' in option[1:]:
            return True
    return False

# The answers to the questions are read from stdin as in an interactive
# session, where a command that cannot be applied (e.g. an invalid "set") is
# only a warning: refuse that mode unless asked for.
if '--allow-stdin' not in sys.argv and stdin_is_redirected() and \
        not (is_forced(sys.argv[1:]) and not stdin_has_input()):
    sys.exit("Reading the answers to the questions from stdin is not supported: write "
             "them to a file, after the line 'launch', and run '%s PATH' "
             "instead, so that an invalid command stops the run.\nUse --allow-stdin "
             "to read stdin as an interactive session (invalid commands then only "
             "warn)." % pjoin(os.path.dirname(sys.argv[0]), 'aMCatNLO'))

sys.path.append(pjoin(root_path,'bin','internal'))
import amcatnlo_run_interface as run      

if sys.version_info < (3, 12):
    sys.exit('MadEvent works with python 3.12 or higher.\n\
               Please upgrade your version of python.')


    
def set_configuration():
    import coloring_logging
    logging.config.fileConfig(os.path.join(root_path, 'bin', 'internal', 'me5_logging.conf'))
    logging.root.setLevel(logging.INFO)
    logging.getLogger('amcatnlo').setLevel(logging.INFO)
    logging.getLogger('madgraph').setLevel(logging.INFO)    


def treat_old_argument(argument):
    """Have the MG4 behavior for this script"""

    try:
        mode = int(argument[1])
    except:
        mode = int(input('Enter 2 for multi-core, 1 for parallel, 0 for serial run\n'))
    if mode == 0:
        try:
            name = argument[2]
        except:
            name = input('Enter run name\n')
    else:
        try:
            opt = argument[2]
        except:
            if mode == 1: 
                opt = input('Enter name for jobs on pbs queue\n')
            else:
                opt = int(input('Enter number of cores\n'))
        
        try:
            name = argument[3]
        except:
            name = input('enter run name\n')

#    launch = ME.MadEventCmd(me_dir=root_path)
        

    if mode == 1:
        argument = ['fake','-f', str(name), '--cluster']
    elif mode == 2:
        argument = ['fake','-f', '--multicore', str(name), '--nb_core=%s' % opt]
    else:
        argument = ['fake','-f', name]

    return argument







################################################################################  
##   EXECUTABLE
################################################################################                                
if '__main__' == __name__:
    # Check that python version is valid

    set_configuration()
    argument = [a for a in sys.argv if a != '--allow-stdin']
    try:
        if '-h' in argument or '--help' in argument:
            launch = run.aMCatNLOCmd(me_dir=root_path)
            launch.exec_cmd('help launch')
            sys.exit()
        elif len(argument) > 1 and argument[1] in ['0', '1', '2']:
            argument = treat_old_argument(argument)
        
        launch = run.aMCatNLOCmd(me_dir=root_path)
        launch.run_cmd('launch %s' % ' '.join(argument[1:]))
        launch.run_cmd('quit')
    except KeyboardInterrupt:
        try:
            launch.run_cmd('quit')
        except:
            pass
                          
    if os.path.exists(pjoin(root_path, 'RunWeb')):  
        os.remove(pjoin(root_path, 'RunWeb'))      
            
    # reconfigure path for the web 
    #if len(argument) == 5:
    #    ME.pass_in_web_mode()

             
        

        
    
    
    
    
    
    
    
