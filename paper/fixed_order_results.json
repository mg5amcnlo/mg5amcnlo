  "formulas": {
    "combined": "W=sum_i 1/delta_i^2; mean=sum_i sigma_i/delta_i^2 / W; delta_mean=1/sqrt(W)",
    "seed_chi2": "sum_i (sigma_i-mean)^2/delta_i^2, 2 degrees of freedom; p=exp(-chi2/2)",
    "seed_pull": "(sigma_i-mean)/sqrt(delta_i^2-delta_mean^2); covariance with the fitted mean is included",
    "comparison_pull": "(mean_A-mean_B)/sqrt(delta_A^2+delta_B^2), independent seeds/exports"
  },
