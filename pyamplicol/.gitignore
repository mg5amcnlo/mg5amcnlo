# Retain local performance campaigns and generated reports outside Git. The
# repository publishes only the report index and four selected PDF snapshots.
/docs/performance_reports/*
!/docs/performance_reports/README.md
!/docs/performance_reports/macbook_M3_pyAmpliCol.pdf
!/docs/performance_reports/EPYC_pyAmpliCol.pdf
!/docs/performance_reports/summary_plots_final.pdf
!/docs/performance_reports/summary_plots_final_helicity_sum.pdf
/docs/arxiv/

