# Makefile for the custom %(kind)s function, generated by bin/init_custom_func.
# Builds $(LIB) from %(body_file)s, its parameters in parameters.h and the UMAMI wrapper.
# Add extra compiler flags to CFLAGS and libraries to LIBS, e.g. for LHAPDF:
#   make CFLAGS="$$(lhapdf-config --cflags)" LIBS="$$(lhapdf-config --libs)"

LANGUAGE = %(language)s
LIB = ../lib/custom_%(kind)s.so
BODY = %(body_file)s

OPTFLAGS ?= -O3
CFLAGS ?=
LIBS ?=

# make predefines CC, CXX and FC; only replace its f77 default
ifeq ($(origin FC),default)
  FC = gfortran
endif

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
  SONAME_FLAGS = -Wl,-install_name,@rpath/$(notdir $(LIB))
else
  SONAME_FLAGS = -Wl,-soname,$(notdir $(LIB))
endif

all: $(LIB)

ifeq ($(LANGUAGE),cuda)

  NVCC ?= nvcc
  # One may pass MADGRAPH_CUDA_ARCHITECTURE (comma-separated list), as for the matrix elements
  comma := ,
  DETECTED_CC := $(shell nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | grep -E '^[0-9]+\.[0-9]+$$' | tr -d '.' | sort -un)
  MADGRAPH_CUDA_ARCHITECTURE ?= $(foreach arch,$(DETECTED_CC),$(arch)$(comma))
  CUDA_ARCH_LIST := $(subst $(comma), ,$(MADGRAPH_CUDA_ARCHITECTURE))
  ifeq ($(strip $(CUDA_ARCH_LIST)),)
    CUDA_ARCH_LIST := 70
  endif
  GPUARCHFLAGS := $(foreach arch,$(CUDA_ARCH_LIST),-gencode arch=compute_$(arch),code=sm_$(arch))

$(LIB): wrapper_gpu.cu $(BODY) parameters.h umami.h
	@mkdir -p $(dir $(LIB))
	$(NVCC) $(OPTFLAGS) -std=c++17 $(GPUARCHFLAGS) -Xcompiler -fPIC --shared $(CFLAGS) \
		-o $@ wrapper_gpu.cu -Xlinker -soname=$(notdir $(LIB)) $(LIBS)

else ifeq ($(LANGUAGE),hip)

  HIP_HOME ?= $(shell hipconfig --rocmpath 2>/dev/null)
  HIPCC ?= $(HIP_HOME)/bin/hipcc
  # One may pass MADGRAPH_HIP_ARCHITECTURE, as for the matrix elements
  ifeq ($(origin MADGRAPH_HIP_ARCHITECTURE),undefined)
    MADGRAPH_HIP_ARCHITECTURE := $(shell $(HIP_HOME)/bin/rocm_agent_enumerator 2>/dev/null | grep -v gfx000 | sort -u | head -1)
  endif
  ifeq ($(MADGRAPH_HIP_ARCHITECTURE),)
    MADGRAPH_HIP_ARCHITECTURE := gfx942
  endif

$(LIB): wrapper_gpu.cu $(BODY) parameters.h umami.h
	@mkdir -p $(dir $(LIB))
	$(HIPCC) $(OPTFLAGS) -std=c++17 --offload-arch=$(MADGRAPH_HIP_ARCHITECTURE) -fPIC -shared \
		$(CFLAGS) -x hip -o $@ wrapper_gpu.cu $(SONAME_FLAGS) $(LIBS)

else

  ifeq ($(LANGUAGE),c)
    BODY_COMPILE = $(CC) $(OPTFLAGS) -fPIC $(CFLAGS)
    LINKER = $(CC)
  else ifeq ($(LANGUAGE),cpp)
    BODY_COMPILE = $(CXX) $(OPTFLAGS) -std=c++17 -fPIC $(CFLAGS)
    LINKER = $(CXX)
  else ifeq ($(LANGUAGE),fortran)
    # parameters.h is included through the preprocessor of .F90 files
    FORTRAN_FLAGS = -DCUSTOM_FORTRAN
    ifneq ($(findstring gfortran,$(FC)),)
      FORTRAN_FLAGS += -ffree-line-length-none
    endif
    BODY_COMPILE = $(FC) $(OPTFLAGS) -fPIC $(FORTRAN_FLAGS) $(CFLAGS)
    LINKER = $(FC)
  else
    $(error unknown LANGUAGE '$(LANGUAGE)': expected c, cpp, fortran, cuda or hip)
  endif

wrapper_cpu.o: wrapper_cpu.c parameters.h umami.h
	$(CC) $(OPTFLAGS) -fPIC -c -o $@ wrapper_cpu.c

body.o: $(BODY) parameters.h
	$(BODY_COMPILE) -c -o $@ $(BODY)

$(LIB): wrapper_cpu.o body.o
	@mkdir -p $(dir $(LIB))
	$(LINKER) -shared -o $@ wrapper_cpu.o body.o $(SONAME_FLAGS) $(LIBS)

endif

clean:
	rm -f *.o *.mod $(LIB)

.PHONY: all clean
